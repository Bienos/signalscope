DATABASE_URL=postgresql+psycopg://radar:radar@db:5432/radar
APP_ENV=development
APP_SECRET=change-this-to-a-long-random-secret
APP_TIMEZONE=Europe/Warsaw
REPORT_TIME=07:30
REPORT_RECIPIENTS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_BACKEND=file
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_DAILY_COST_LIMIT=0
PROVIDER_TYPE=mock
PROVIDER_BASE_URL=
PROVIDER_AUTH_HEADER=Authorization
PROVIDER_AUTH_TOKEN=
PROVIDER_FIELD_MAPPING={}
APIFY_ENABLED=false
APIFY_TOKEN=
APIFY_API_BASE=https://api.apify.com/v2
APIFY_DISCOVERY_ACTOR_ID=clockworks~tiktok-scraper
APIFY_PROFILE_ACTOR_ID=clockworks~tiktok-profile-scraper
APIFY_PROFILE_ENRICHMENT_ENABLED=false
APIFY_MAX_RESULTS_PER_QUERY=50
APIFY_DEFAULT_MARKET=GB
APIFY_SUPPORTED_MARKETS=GB,PL
APIFY_RUN_TIMEOUT_SECONDS=900
APIFY_REQUEST_TIMEOUT_SECONDS=60
APIFY_MONTHLY_BUDGET_USD=50
APIFY_RAW_PAYLOAD_RETENTION_DAYS=14
TOY_DISCOVERY_ENABLED=true
TOY_MONITORING_PERCENTAGE=10
TOY_PROVIDER_MODE=demo
# Leave blank to use backend/app/domain/toys/seeds.json; set only as an explicit override.
APIFY_SEARCH_QUERIES=
APIFY_HASHTAGS=
APIFY_PROFILES=
APIFY_POST_URLS=
RETENTION_USERNAME_DAYS=365
RETENTION_DISPLAY_NAME_DAYS=180
RETENTION_CONTENT_DAYS=180
RETENTION_METRICS_DAYS=730
VIRAL_VIEW_THRESHOLD=1000000
MIN_EMERGING_GROWTH=5000
MAX_EMERGING_ANOMALY=40
EMERGING_MAX_AGE_HOURS=72
EXPECTED_FRESHNESS_HOURS=8
FEATURE_AI=false
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
# Allows unauthenticated reads of clearly labelled synthetic fixtures only.
# Mutations and exports still require a signed-in backend session.
SIGNALSCOPE_DEMO_MODE=true
# Local HTTP only. Leave unset (secure by default) behind production HTTPS.
SIGNALSCOPE_SESSION_COOKIE_SECURE=false
